# Copy to .env for local development. NEVER commit a filled-in .env.
# In production (Fly) these are set with `fly secrets set KEY=value`.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Preferred: a single connection string (Fly Postgres, Neon, Supabase, ...).
# DATABASE_URL=postgres://user:pass@host:5432/clipso_licenses

# TLS: auto-on in production / when sslmode=require is in the URL.
# Set to "disable" for Fly's private network (*.flycast / *.internal) or local docker.
# DATABASE_SSL=disable

# Local dev fallback (used only when DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clipso_licenses
DB_USER=postgres
DB_PASSWORD=your_database_password

# ---------------------------------------------------------------------------
# Paddle
# ---------------------------------------------------------------------------
# Paddle Dashboard -> Developer Tools -> Notifications -> your destination's secret.
# Without this, /webhook/paddle rejects every request.
PADDLE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Bearer token for GET /api/licenses/:key (exposes customer data).
# Unset = that endpoint is disabled. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Tuning (optional)
# ---------------------------------------------------------------------------
# RATE_LIMIT_MAX=60      # license requests per IP per 15 min
# DB_POOL_MAX=10

# Optional: email service for sending license keys
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=your_email_api_key
# EMAIL_FROM=noreply@clipso.app
